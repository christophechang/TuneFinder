<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly artist dictionary — crawl Beatport into crawl.db until 05:30 (backfill,
     then a top-up of the current and previous month), export the shards, upload them
     to the multi-tenant API. See src/publisher/dictionary/__init__.py.
     Update all paths below to match your actual deployment checkout location.
     Replaces com.openclaw.artist-crawl (unload that first); the database stays at
     ~/OpenClaw/Automations/artist-crawl/crawl.db, the default for --db.
     Add a second "env" pair (prod) only once prod serves the dictionary routes.
     Loading this job does not change com.openclaw.tune-finder or the publisher. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openclaw.tunefinder-dictionary</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_ADMIN_USER/Documents/Development/TuneFinder/venv/bin/python</string>
    <string>-m</string>
    <string>src.publisher.dictionary</string>
    <string>nightly</string>
    <string>--until</string>
    <string>05:30</string>
    <string>--env</string>
    <string>dev</string>
  </array>

  <!-- The checkout, so load_dotenv() finds .env and the Beatport token cache in data/ -->
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_ADMIN_USER/Documents/Development/TuneFinder</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_ADMIN_USER/Documents/Development/TuneFinder/logs/dictionary.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_ADMIN_USER/Documents/Development/TuneFinder/logs/dictionary.launchd.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
